# MySQL配置
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_PASSWORD=your_strong_user_password_here

# 大模型API
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# JWT配置
JWT_SECRET=your_jwt_secret_key_at_least_32_characters

# 对象存储配置（如果使用）
