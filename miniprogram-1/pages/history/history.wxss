/* 页面头部 */
.page-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #657594;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #315bd8 0%, #203a91 100%);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(49, 91, 216, 0.3);
}

.stat-box {
  text-align: center;
  flex: 1;
}

.stat-number {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.divider {
  width: 2rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 列表头部 */
.list-header {
  margin-bottom: 24rpx;
}

.list-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* 历史记录项 */
.history-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.date-badge {
  display: flex;
  align-items: center;
}

.calendar-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.date-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-right: 16rpx;
}

.subject-tag {
  font-size: 24rpx;
  color: #315bd8;
  background: rgba(49, 91, 216, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.score-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.score-excellent {
  background: #d4edda;
  color: #155724;
}

.score-good {
  background: #cfe2ff;
  color: #084298;
}

.score-normal {
  background: #fff3cd;
  color: #856404;
}

.item-body {
  display: flex;
  justify-content: space-between;
}

.metric {
  flex: 1;
  text-align: center;
}

.metric-label {
  display: block;
  font-size: 24rpx;
  color: #657594;
  margin-bottom: 8rpx;
}

.metric-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.accuracy-excellent {
  color: #28a745;
}

.accuracy-good {
  color: #0d6efd;
}

.accuracy-normal {
  color: #ffc107;
}

.metric-value.points {
  color: #d97706;
  font-weight: 700;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: #7383a1;
}

/* 列表底部加载提示 */
.list-footer {
  padding: 32rpx 0;
  text-align: center;
}

.list-footer-text {
  font-size: 26rpx;
  color: #7383a1;
}




/* 太空探索主题 */
.page-header { text-align: left; }
.page-title { color: #1f2e52; font-size: 42rpx; }
.stats-card { background: #315bd8; border-radius: 24rpx; box-shadow: 0 6rpx 0 #203a91; padding: 32rpx 16rpx; }
.history-item { background: #ffffff; border: 2rpx solid #d5e0f3; box-shadow: 0 5rpx 0 #e0e7f5; }
.subject-tag { color: #2547a5; background: #e3ebff; }
.date-badge { flex-wrap: wrap; }
.score-badge { flex-shrink: 0; }
