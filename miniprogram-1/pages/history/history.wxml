<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">📖 学习历程</text>
    <text class="page-subtitle">记录你的每一次进步</text>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stat-box">
      <text class="stat-number">{{totalDays}}</text>
      <text class="stat-label">累计天数</text>
    </view>
    <view class="divider"></view>
    <view class="stat-box">
      <text class="stat-number">{{totalQuestions}}</text>
      <text class="stat-label">总题数</text>
    </view>
    <view class="divider"></view>
    <view class="stat-box">
      <text class="stat-number">{{avgAccuracy}}%</text>
      <text class="stat-label">平均正确率</text>
    </view>
  </view>

  <!-- 历史记录列表 -->
  <view class="history-list" wx:if="{{historyList.length > 0}}">
    <view class="list-header">
      <text class="list-title">答题记录</text>
    </view>

    <view class="history-item" wx:for="{{historyList}}" wx:key="timestamp">
      <view class="item-header">
        <view class="date-badge">
          <text class="calendar-icon">📅</text>
          <text class="date-text">{{item.date}}</text>
        </view>
        <view class="score-badge score-{{item.level}}">
          <text>{{item.levelText}}</text>
        </view>
      </view>

      <view class="item-body">
        <view class="metric">
          <text class="metric-label">正确题数</text>
          <text class="metric-value">{{item.correctCount}}/{{item.totalQuestions}}</text>
        </view>
        <view class="metric">
          <text class="metric-label">正确率</text>
          <text class="metric-value accuracy-{{item.level}}">{{item.accuracy}}%</text>
        </view>
        <view class="metric">
          <text class="metric-label">获得积分</text>
          <text class="metric-value points">+{{item.earnedPoints}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📚</text>
    <text class="empty-text">还没有答题记录哦</text>
    <text class="empty-hint">完成每日挑战后会显示在这里</text>
  </view>
</view>
