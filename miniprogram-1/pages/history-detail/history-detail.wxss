.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #ffffff 30%);
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
  padding: 40rpx 30rpx 30rpx;
  color: #ffffff;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.3);
}

.header-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.subject-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.subject-name {
  font-size: 40rpx;
  font-weight: 700;
}

.date-text {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
  display: block;
}

/* 统计信息 */
.stats {
  display: flex;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  backdrop-filter: blur(10rpx);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-value.correct {
  color: #4ade80;
}

.stat-value.wrong {
  color: #f87171;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
}

/* 题目列表 */
.questions-list {
  padding: 30rpx;
}

.question-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 题目头部 */
.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.question-number {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.question-type {
  font-size: 24rpx;
  color: #6366f1;
  background: rgba(99, 102, 241, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.result-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.result-badge.correct {
  background: rgba(74, 222, 128, 0.15);
  color: #16a34a;
}

.result-badge.wrong {
  background: rgba(248, 113, 113, 0.15);
  color: #dc2626;
}

/* 题目内容 */
.question-content {
  margin-bottom: 24rpx;
}

.question-text {
  font-size: 32rpx;
  line-height: 1.8;
  color: #111827;
}

/* 选项 */
.options {
  margin-bottom: 24rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #f9fafb;
  border-radius: 16rpx;
  border: 2rpx solid #e5e7eb;
  position: relative;
}

.option-correct {
  background: rgba(74, 222, 128, 0.1);
  border-color: #4ade80;
}

.option-wrong {
  background: rgba(248, 113, 113, 0.1);
  border-color: #f87171;
}

.option-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #6366f1;
  margin-right: 16rpx;
  min-width: 50rpx;
}

.option-text {
  font-size: 28rpx;
  color: #374151;
  flex: 1;
  line-height: 1.6;
}

.option-mark {
  font-size: 32rpx;
  color: #16a34a;
  font-weight: 700;
}

.option-mark.wrong-mark {
  color: #dc2626;
}

/* 答案区域 */
.answer-section {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.answer-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.answer-row:last-child {
  margin-bottom: 0;
}

.answer-label {
  font-size: 28rpx;
  color: #6b7280;
  min-width: 160rpx;
}

.answer-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.answer-value.correct-text {
  color: #16a34a;
}

.answer-value.wrong-text {
  color: #dc2626;
}

/* 解析 */
.analysis {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.analysis-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #92400e;
  margin-bottom: 12rpx;
}

.analysis-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #78350f;
}

/* 知识点 */
.knowledge-point {
  display: flex;
  align-items: center;
  background: rgba(99, 102, 241, 0.08);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.kp-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.kp-text {
  font-size: 26rpx;
  color: #4f46e5;
  font-weight: 500;
}
