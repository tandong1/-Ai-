page {
  background: #f0f5ff;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
}

.records-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.record-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.record-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2e52;
}

.record-time {
  font-size: 24rpx;
  color: #7383a1;
}

.record-points {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.points-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #ef4444;
}

.points-unit {
  font-size: 22rpx;
  color: #7383a1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #657594;
  margin-bottom: 16rpx;
}

.empty-hint {
  display: block;
  font-size: 26rpx;
  color: #7383a1;
}


/* 太空探索主题 */
.record-item { background: #ffffff; border: 2rpx solid #d5e0f3; box-shadow: 0 5rpx 0 #e0e7f5; }
.record-content { min-width: 0; }
.record-name { word-break: break-all; }
.record-points { margin-left: 16rpx; flex-shrink: 0; }
