/* 太空探索：首页 */
page { background: #f0f5ff; }
.container { padding: 28rpx 32rpx 40rpx; }
.header-info, .date-info, .points-badge { display: flex; align-items: center; }
.header-info { justify-content: space-between; margin-bottom: 32rpx; }
.date-info { padding: 12rpx 0; }
.date-icon, .trophy-icon { font-size: 28rpx; margin-right: 10rpx; }
.date-text { font-size: 25rpx; color: #657594; }
.points-badge { padding: 12rpx 20rpx; background: #ffe0b3; border: 2rpx solid #f5bf82; border-radius: 16rpx; }
.points-text { font-size: 26rpx; color: #855020; font-weight: 700; }
.adventure-hero { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 36rpx 28rpx; background: #e3ebff; border: 2rpx solid #c8d5f4; border-radius: 28rpx; margin-bottom: 40rpx; overflow: hidden; }
.hero-copy { flex: 1; min-width: 0; }
.hero-label { font-size: 22rpx; color: #526da6; letter-spacing: 3rpx; }
.page-title { font-size: 38rpx; font-weight: 800; color: #1f2e52; margin: 16rpx 0; line-height: 1.4; }
.hero-desc { font-size: 23rpx; color: #52678f; }
.hero-stamp { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; margin-left: 12rpx; transform: rotate(8deg); }
.stamp-icon { font-size: 68rpx; }
.stamp-text { font-size: 22rpx; color: #315bd8; font-weight: 700; border-bottom: 3rpx solid #315bd8; }
.section-heading { display: flex; align-items: center; justify-content: space-between; font-size: 30rpx; font-weight: 700; margin-bottom: 22rpx; }
.section-note { font-size: 22rpx; color: #657594; font-weight: 400; }
.subject-list { margin-bottom: 36rpx; }
.subject-card { display: flex; align-items: center; border: 2rpx solid; border-radius: 24rpx; padding: 30rpx 24rpx; margin-bottom: 22rpx; box-shadow: 0 6rpx 0 rgba(31,46,82,.12); transition: transform .15s; }
.subject-card:active { transform: translateY(4rpx); box-shadow: none; }
.math-card { background: #e7edff; border-color: #c4d1ff; }
.english-card { background: #e4f3ff; border-color: #beddf4; }
.chinese-card { background: #fff0e2; border-color: #f1d2b4; }
.subject-icon { font-size: 52rpx; margin-right: 24rpx; width: 86rpx; height: 86rpx; border-radius: 20rpx; background: rgba(255,255,255,.65); display: flex; align-items: center; justify-content: center; }
.subject-info { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.subject-name { font-size: 34rpx; font-weight: 700; margin-bottom: 6rpx; }
.subject-desc { font-size: 23rpx; color: #52678f; }
.arrow-icon { font-size: 34rpx; color: #315bd8; margin-left: 12rpx; }
.today-progress { background: #ffffff; border: 2rpx solid #d5e0f3; border-radius: 24rpx; padding: 28rpx; }
.progress-title { font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx; }
.progress-items { display: flex; justify-content: space-between; }
.progress-item { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 10rpx 0; border-right: 2rpx dashed #d5e0f3; }
.progress-item:last-child { border-right: none; }
.progress-subject { font-size: 26rpx; margin-bottom: 14rpx; }
.progress-status { font-size: 22rpx; padding: 6rpx 14rpx; border-radius: 10rpx; }
.progress-status.completed { color: #2547a5; background: #e2f2ed; }
.progress-status.pending { color: #63738f; background: #edf1f8; }

/* 星际任务站 */
.adventure-hero { background: #203a79; border-color: #304f94; border-radius: 36rpx 36rpx 72rpx 36rpx; padding: 42rpx 28rpx; }
.adventure-hero::before { content: ''; position: absolute; width: 220rpx; height: 220rpx; right: -70rpx; top: -90rpx; border: 2rpx solid #5775b6; border-radius: 50%; pointer-events: none; }
.hero-copy, .hero-stamp { position: relative; z-index: 1; }
.hero-label { color: #b8ccff; }
.page-title { color: #ffffff; font-size: 36rpx; }
.hero-desc { color: #d0ddff; font-size: 22rpx; }
.hero-stamp { transform: rotate(-8deg); }
.stamp-icon { font-size: 76rpx; }
.stamp-text { color: #ffce90; border: none; font-size: 20rpx; }
.subject-card { border-radius: 32rpx; box-shadow: 0 8rpx 20rpx rgba(31,46,82,.06); }
.subject-icon { border-radius: 50%; }
.arrow-icon { width: 48rpx; height: 48rpx; background: #ffffff; border-radius: 50%; text-align: center; line-height: 48rpx; }
.today-progress { border-radius: 32rpx; }

/* 全部完成后在原进度区域展示刮奖卡 */
.scratch-result { padding: 28rpx 24rpx; border-radius: 24rpx; background: #fff5df; text-align: center; }
.scratch-prize { display: block; color: #855020; font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
.scratch-message { display: block; font-size: 28rpx; line-height: 1.8; color: #35476b; }
.scratch-retry { background: #315bd8; color: white; border-radius: 16rpx; font-size: 26rpx; margin-top: 20rpx; }
