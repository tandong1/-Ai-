<view class="container">
  <!-- 顶部信息栏 -->
  <view class="header-info">
    <view class="date-info">
      <text class="date-icon">📅</text>
      <text class="date-text">{{currentDate}}</text>
    </view>
    <view class="points-badge">
      <text class="trophy-icon">🏆</text>
      <text class="points-text">{{totalPoints}}分</text>
    </view>
  </view>

  <view class="adventure-hero">
    <view class="hero-copy">
      <text class="hero-label">小小学霸 · 星际任务站</text>
      <view class="page-title">下一站，知识宇宙！</view>
      <text class="hero-desc">第一次全部答对一个科目，会加两个积分哦。</text>
    </view>
    <view class="hero-stamp"><text class="stamp-icon">🚀</text><text class="stamp-text">准备起飞</text></view>
  </view>
  <view class="section-heading"><text>选择目标星球</text><text class="section-note">共 3 个科目</text></view>

  <!-- 科目卡片列表 -->
  <view class="subject-list">
    <view class="subject-card math-card" bindtap="goToSubject" data-subject="math">
      <view class="subject-icon">🪐</view>
      <view class="subject-info">
        <text class="subject-name">数学</text>
        <text class="subject-desc">逻辑思维 · 计算能力</text>
      </view>
      <view class="arrow-icon">→</view>
    </view>

    <view class="subject-card english-card" bindtap="goToSubject" data-subject="english">
      <view class="subject-icon">🛰️</view>
      <view class="subject-info">
        <text class="subject-name">英语</text>
        <text class="subject-desc">词汇积累 · 语言能力</text>
      </view>
      <view class="arrow-icon">→</view>
    </view>

    <view class="subject-card chinese-card" bindtap="goToSubject" data-subject="chinese">
      <view class="subject-icon">🌟</view>
      <view class="subject-info">
        <text class="subject-name">语文</text>
        <text class="subject-desc">阅读理解 · 文字表达</text>
      </view>
      <view class="arrow-icon">→</view>
    </view>
  </view>

  <!-- 今日进度 -->
  <view class="today-progress">
    <view class="progress-title">{{scratch.eligible ? '今日奖励' : '今日任务进度'}}</view>
    <view class="progress-items" wx:if="{{!scratch.eligible}}">
      <view class="progress-item">
        <text class="progress-subject">数学</text>
        <text class="progress-status {{todayProgress.math ? 'completed' : 'pending'}}">
          {{todayProgress.math ? '已完成' : '待出发'}}
        </text>
      </view>
      <view class="progress-item">
        <text class="progress-subject">英语</text>
        <text class="progress-status {{todayProgress.english ? 'completed' : 'pending'}}">
          {{todayProgress.english ? '已完成' : '待出发'}}
        </text>
      </view>
      <view class="progress-item">
        <text class="progress-subject">语文</text>
        <text class="progress-status {{todayProgress.chinese ? 'completed' : 'pending'}}">
          {{todayProgress.chinese ? '已完成' : '待出发'}}
        </text>
      </view>
    </view>
    <view wx:else class="daily-scratch">
      <scratch-card wx:if="{{!scratch.revealed && !scratchStarted}}" bind:reveal="revealScratch" />
      <view wx:elif="{{scratch.revealed}}" class="scratch-result">
        <text class="scratch-prize">{{scratch.points > 0 ? '+' + scratch.points + ' 积分' : '今日未中奖'}}</text>
        <text class="scratch-message">{{scratch.message}}</text>
      </view>
      <view wx:else class="scratch-result">
        <text class="scratch-message">{{scratchLoading ? '正在揭晓今日惊喜…' : '结果暂未加载，请重试'}}</text>
        <button wx:if="{{!scratchLoading}}" class="scratch-retry" bindtap="revealScratch">重新揭晓</button>
      </view>
    </view>
  </view>
</view>
