<view class="splash-container {{fadeIn ? 'fade-in' : ''}}">
  <!-- 背景装饰 -->
  <view class="background-decoration">
    <view class="circle circle-1"></view>
    <view class="circle circle-2"></view>
    <view class="circle circle-3"></view>
  </view>

  <!-- 主要内容 -->
  <view class="content">
    <!-- Logo区域 -->
    <view class="logo-section">
      <view class="logo-icon">
        <text class="icon-brain">🧠</text>
        <view class="glow"></view>
      </view>
      <text class="app-name">小小学霸</text>
    </view>

    <!-- 标语 -->
    <view class="slogan {{textShow ? 'text-show' : ''}}">
      <view class="slogan-line">
        <text class="highlight">基于AI的</text>
      </view>
      <view class="slogan-line">
        <text class="main-text">自动学习管理</text>
      </view>
    </view>

    <!-- 装饰元素 -->
    <view class="stars">
      <text class="star star-1">✨</text>
      <text class="star star-2">⭐</text>
      <text class="star star-3">💫</text>
      <text class="star star-4">✨</text>
    </view>
  </view>

  <!-- 底部文字 -->
  <view class="footer {{textShow ? 'text-show' : ''}}">
    <text class="powered-by">智能陪伴 · 快乐成长</text>
  </view>
</view>
