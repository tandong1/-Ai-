page {
  min-height: 100vh;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
  transition: background 0.3s;
}

.container.math-theme {
  background: linear-gradient(135deg, #3b82f6 0%, #1e40af 100%);
}

.container.english-theme {
  background: linear-gradient(135deg, #10b981 0%, #047857 100%);
}

.container.chinese-theme {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

/* 顶部信息 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.subject-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  padding: 16rpx 28rpx;
  border-radius: 48rpx;
}

.subject-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.subject-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.progress-info {
  background: rgba(255, 255, 255, 0.95);
  padding: 16rpx 28rpx;
  border-radius: 48rpx;
}

.progress-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

/* 题目卡片 */
.question-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  min-height: 600rpx;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.question-type-badge {
  background: #f3f4f6;
  color: #6b7280;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.question-number {
  font-size: 28rpx;
  color: #9ca3af;
  font-weight: 500;
}

.question-content {
  background: #f9fafb;
  padding: 32rpx;
  border-radius: 20rpx;
  margin-bottom: 32rpx;
  border-left: 6rpx solid #6366f1;
}

.question-text {
  font-size: 32rpx;
  line-height: 1.8;
  color: #1f2937;
  font-weight: 500;
}

/* 选择题选项 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  background: #f9fafb;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.option-item:active {
  transform: scale(0.98);
}

.option-item.selected {
  background: #e0e7ff;
  border-color: #6366f1;
}

.option-label {
  width: 56rpx;
  height: 56rpx;
  background: #6366f1;
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-item.selected .option-label {
  background: #4f46e5;
  transform: scale(1.1);
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: #374151;
  line-height: 1.6;
}

/* 填空题 */
.fill-blank-area {
  position: relative;
}

.answer-input {
  width: 100%;
  min-height: 300rpx;
  background: #f9fafb;
  border: 3rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #1f2937;
  line-height: 1.6;
}

.answer-input:focus {
  border-color: #6366f1;
  background: #ffffff;
}

.char-count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 底部按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.action-buttons button {
  flex: 1;
  border-radius: 48rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.9);
  color: #374151;
}

.btn-primary {
  background: #ffffff;
  color: #1f2937;
}

.btn-submit {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(251, 191, 36, 0.4);
}

/* 进度条 */
.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #ffffff;
  border-radius: 12rpx;
  transition: width 0.3s ease;
}

