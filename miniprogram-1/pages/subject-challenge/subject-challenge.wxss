/* 整体容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #315bd8 0%, #203a91 100%);
  padding: 40rpx 30rpx;
}

.container.math {
  background: linear-gradient(135deg, #315bd8 0%, #203a91 100%);
}

.container.english {
  background: linear-gradient(135deg, #76b7a4 0%, #317f6a 100%);
}

.container.chinese {
  background: linear-gradient(135deg, #e9c772 0%, #e4ac64 100%);
}

/* 顶部信息 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.subject-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 24rpx;
  border-radius: 50rpx;
  backdrop-filter: blur(10px);
}

.subject-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.subject-name {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.progress-info {
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 24rpx;
  border-radius: 50rpx;
  backdrop-filter: blur(10px);
}

.progress-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

/* 题目卡片 */
.question-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 30rpx;
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.question-type-badge {
  background: linear-gradient(135deg, #315bd8 0%, #203a91 100%);
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.question-number {
  color: #999;
  font-size: 28rpx;
}

.question-content {
  margin-bottom: 40rpx;
}

.question-text {
  color: #333;
  font-size: 32rpx;
  line-height: 1.8;
  font-weight: 500;
}

/* 选择题选项 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #d5e0f3;
  border-radius: 16rpx;
  transition: all 0.3s;
  background: #f7f5ed;
}

.option-item.selected {
  border-color: #315bd8;
  background: #e8efff;
}

.option-label {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #315bd8;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-item.selected .option-label {
  background: #2547a5;
  transform: scale(1.1);
}

.option-text {
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
  flex: 1;
}

/* 填空题输入框 */
.fill-blank-area {
  position: relative;
}

.answer-input {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  border: 2rpx solid #d5e0f3;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  background: #f7f5ed;
  box-sizing: border-box;
}

.char-count {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  color: #999;
  font-size: 24rpx;
}

/* 反馈信息 */
.feedback-box {
  margin-top: 30rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border-left: 6rpx solid;
}

.feedback-box.correct {
  background: #edf7f0;
  border-color: #10b981;
}

.feedback-box.wrong {
  background: #fef2f2;
  border-color: #ef4444;
}

.feedback-text {
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 解析框 */
.analysis-box {
  margin-top: 30rpx;
  padding: 24rpx;
  background: #fffbeb;
  border-radius: 16rpx;
  border-left: 6rpx solid #f59e0b;
}

.analysis-title {
  color: #f59e0b;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.analysis-text {
  color: #333;
  font-size: 26rpx;
  line-height: 1.8;
}

.correct-answer-box {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #fde68a;
}

.correct-answer-label {
  color: #666;
  font-size: 26rpx;
}

.correct-answer-value {
  color: #10b981;
  font-size: 28rpx;
  font-weight: bold;
  margin-left: 10rpx;
}

/* 底部按钮 */
.action-buttons {
  margin-bottom: 30rpx;
}

.button-group {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.button-group > button {
  flex: 1 1 0%;
  width: 0;
  min-width: 0;
}

.btn-submit,
.btn-primary,
.btn-secondary,
.btn-retry,
.btn-finish,
.btn-back {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 500;
  white-space: nowrap;
  border: none;
}

.btn-submit,
.btn-primary,
.btn-finish {
  background: linear-gradient(135deg, #315bd8 0%, #203a91 100%);
  color: #fff;
}

.btn-secondary {
  background: #e3ebff;
  color: #35476b;
  box-shadow: 0 6rpx 0 #c8d5f4;
}

.btn-retry {
  background: #fef3c7;
  color: #855020;
  box-shadow: 0 6rpx 0 #ead69a;
}

/* 进度条 */
.progress-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 8rpx;
  transition: width 0.3s;
}

/* 完成结果页 */
.result-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.result-icon {
  font-size: 160rpx;
  margin-bottom: 40rpx;
}

.result-title {
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 60rpx;
}

.result-stats {
  display: flex;
  gap: 40rpx;
  margin-bottom: 80rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  padding: 40rpx 60rpx;
  border-radius: 24rpx;
  backdrop-filter: blur(10px);
}

.stat-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.stat-value {
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
}

.btn-back {
  width: 400rpx;
  max-width: 100%;
  height: 96rpx;
  background: #fff;
  color: #315bd8;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}


/* 太空探索主题 */
.container, .container.math, .container.english, .container.chinese { background: #f0f5ff; }
.subject-badge, .progress-info { background: #e3ebff; border-radius: 16rpx; }
.subject-name, .progress-text, .result-title, .stat-value { color: #1f2e52; }
.question-card { border: 2rpx solid #d5e0f3; box-shadow: 0 8rpx 0 #dce5f8; border-radius: 28rpx; padding: 32rpx; }
.question-type-badge { background: #e3ebff; color: #2547a5; border-radius: 10rpx; }
.option-item { background: #ffffff; border-color: #d5e0f3; min-height: 70rpx; }
.option-item.selected { border-color: #315bd8; background: #e8efff; box-shadow: 0 4rpx 0 #c8d5f4; }
.option-label { background: #e3ebff; color: #2547a5; border-radius: 14rpx; }
.option-item.selected .option-label { background: #315bd8; color: #fff; }
.btn-submit, .btn-primary, .btn-finish { background: #315bd8; box-shadow: 0 6rpx 0 #203a91; }
.progress-bar { background: #d5e0f3; height: 14rpx; margin-top: 38rpx; }
.progress-fill { background: #5c83ed; }
.result-stats { width: 100%; gap: 16rpx; }
.stat-item { flex: 1; padding: 32rpx 12rpx; background: #e3ebff; }
.stat-label { color: #52678f; }
.btn-back { background: #315bd8; color: #fff; }
