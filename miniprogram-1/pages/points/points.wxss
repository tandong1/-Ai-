/* 积分头部 */
.points-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.avatar-section {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-icon {
  font-size: 64rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 600;
}

.switch-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.points-display {
  text-align: center;
}

.points-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 12rpx;
}

.points-value {
  display: flex;
  align-items: center;
  justify-content: center;
}

.trophy-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.points-number {
  font-size: 72rpx;
  font-weight: 700;
  color: #ffffff;
}

/* 积分商城入口 */
.shop-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(251, 191, 36, 0.3);
  transition: transform 0.3s;
}

.shop-entry:active {
  transform: scale(0.98);
}

.shop-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.shop-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-icon {
  font-size: 56rpx;
}

.shop-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.shop-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.shop-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.shop-arrow {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
}

/* 等级卡片 */
.level-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.level-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.level-badge {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
}

.level-icon {
  font-size: 56rpx;
}

.level-details {
  flex: 1;
}

.level-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.level-desc {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
}

.progress-section {
  margin-top: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 26rpx;
  color: #6b7280;
}

.progress-text {
  font-size: 28rpx;
  color: #6366f1;
  font-weight: 600;
}

.level-progress-bar {
  height: 16rpx;
  background: #e5e7eb;
  border-radius: 16rpx;
  overflow: hidden;
}

.level-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  transition: width 0.5s ease;
}

/* 成就墙 */
.achievements-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.section-subtitle {
  font-size: 26rpx;
  color: #6b7280;
}

.achievements-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.achievement-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.achievement-item.locked {
  opacity: 0.5;
}

.achievement-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.achievement-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.achievement-desc {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
}

.lock-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.lock-icon {
  font-size: 40rpx;
}

/* 积分明细 */
.points-detail-section {
  margin-bottom: 24rpx;
}

.detail-list {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.detail-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.detail-info {
  flex: 1;
}

.detail-title {
  display: block;
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 6rpx;
}

.detail-time {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
}

.detail-points {
  font-size: 32rpx;
  font-weight: 700;
}

.detail-points.positive {
  color: #28a745;
}

/* 空状态 */
.empty-detail {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 80rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.empty-icon {
  display: block;
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
}




