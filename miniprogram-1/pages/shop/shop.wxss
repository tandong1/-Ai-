page {
  background: #f0f5ff;
}

.container {
  padding-bottom: 120rpx;
}

/* 顶部积分信息 */
.points-header {
  background: linear-gradient(135deg, #315bd8 0%, #203a91 100%);
  padding: 48rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-avatar-small {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-name-small {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.points-display {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 24rpx;
  border-radius: 48rpx;
}

.points-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 4rpx;
}

.points-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fbbf24;
}

/* 礼物列表 */
.gifts-section {
  padding: 32rpx;
}

.section-title {
  margin-bottom: 32rpx;
}

.title-text {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2e52;
  margin-bottom: 8rpx;
}

.title-desc {
  display: block;
  font-size: 26rpx;
  color: #657594;
}

.gifts-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 礼物卡片 */
.gift-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.gift-swiper {
  width: 100%;
  height: 400rpx;
}

.gift-image {
  width: 100%;
  height: 100%;
}

.gift-info {
  padding: 32rpx;
}

.gift-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2e52;
  margin-bottom: 12rpx;
}

.gift-desc {
  display: block;
  font-size: 26rpx;
  color: #657594;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.gift-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.gift-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-icon {
  font-size: 32rpx;
}

.price-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #f59e0b;
}

.price-unit {
  font-size: 24rpx;
  color: #7383a1;
}

.exchange-btn {
  padding: 16rpx 32rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.exchange-btn.active {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  color: #ffffff;
}

.exchange-btn.disabled {
  background: #d5e0f3;
  color: #7383a1;
}

/* 兑换记录按钮 */
.records-btn {
  position: fixed;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  padding: 24rpx 48rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.records-icon {
  font-size: 32rpx;
}

.records-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2e52;
}


/* 太空探索主题 */
.points-header { background: #315bd8; border-radius: 24rpx; padding: 28rpx; }
.gifts-section { padding: 32rpx 0; }
.gift-card { background: #ffffff; border: 2rpx solid #d5e0f3; box-shadow: 0 6rpx 0 #e0e7f5; }
.exchange-btn.active { background: #315bd8; }
.records-btn { border: 2rpx solid #d5e0f3; border-radius: 20rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.container { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }

.exchange-overlay { position: fixed; inset: 0; background: rgba(15,30,60,.5); z-index: 100; display: flex; align-items: center; justify-content: center; }
.exchange-panel { width: 650rpx; max-height: 80vh; background: #fff; border-radius: 24rpx; padding: 32rpx; box-sizing: border-box; }
.exchange-title { display: block; font-size: 32rpx; font-weight: bold; }
.exchange-cost { display: block; margin: 16rpx 0; color: #315bd8; }
.exchange-panel input, .exchange-panel textarea { box-sizing: border-box; width: 100%; background: #f2f5fa; border-radius: 12rpx; padding: 18rpx; margin-bottom: 20rpx; font-size: 28rpx; }
.exchange-panel input { height: 84rpx; }
.exchange-panel textarea { height: 140rpx; }
.exchange-panel button { margin: 16rpx 0; }
