page {
  background: #f5f7fa;
}

.container {
  padding-bottom: 120rpx;
}

/* 顶部积分信息 */
.points-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 48rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-avatar-small {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.user-name-small {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.points-display {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 24rpx;
  border-radius: 48rpx;
}

.points-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 4rpx;
}

.points-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fbbf24;
}

/* 礼物列表 */
.gifts-section {
  padding: 32rpx;
}

.section-title {
  margin-bottom: 32rpx;
}

.title-text {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.title-desc {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
}

.gifts-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 礼物卡片 */
.gift-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.gift-swiper {
  width: 100%;
  height: 400rpx;
}

.gift-image {
  width: 100%;
  height: 100%;
}

.gift-info {
  padding: 32rpx;
}

.gift-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
}

.gift-desc {
  display: block;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.gift-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.gift-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-icon {
  font-size: 32rpx;
}

.price-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #f59e0b;
}

.price-unit {
  font-size: 24rpx;
  color: #9ca3af;
}

.exchange-btn {
  padding: 16rpx 32rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.exchange-btn.active {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  color: #ffffff;
}

.exchange-btn.disabled {
  background: #e5e7eb;
  color: #9ca3af;
}

/* 兑换记录按钮 */
.records-btn {
  position: fixed;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  padding: 24rpx 48rpx;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.records-icon {
  font-size: 32rpx;
}

.records-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}
