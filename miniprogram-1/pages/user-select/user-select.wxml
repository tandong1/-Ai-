<view class="container">
  <view class="title-section">
    <text class="main-title">小小学霸</text>
    <text class="sub-title">选择你的身份开始学习</text>
  </view>

  <view class="users-section">
    <view
      wx:for="{{users}}"
      wx:key="id"
      class="user-card"
      bindtap="selectUser"
      data-id="{{item.id}}">
      <view class="avatar-wrapper">
        <image class="user-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view class="avatar-border"></view>
      </view>
      <text class="user-name">{{item.name}}</text>
      <view class="user-stats">
        <text class="stats-item">🏆 {{item.points}}分</text>
      </view>
    </view>
  </view>

  
</view>
