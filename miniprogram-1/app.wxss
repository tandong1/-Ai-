/* 全局样式 */
page {
  background-color: #f0f5ff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 通用容器 */
.container {
  padding: 32rpx;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* 按钮样式 */
.primary-btn {
  background: linear-gradient(135deg, #315bd8 0%, #203a91 100%);
  color: #ffffff;
  border-radius: 48rpx;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(49, 91, 216, 0.3);
}

.secondary-btn {
  background: #e8efff;
  color: #315bd8;
  border-radius: 48rpx;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}


/* 太空探索主题 */
page { color: #1f2e52; line-height: 1.5; }
.container { box-sizing: border-box; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
button::after { border: none; }
.primary-btn { background: #315bd8; border-radius: 20rpx; box-shadow: 0 6rpx 0 #203a91; }
.secondary-btn { background: #e8efff; border-radius: 20rpx; }
